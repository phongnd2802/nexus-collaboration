# =====================================================
# NEXUS AI SERVICE CONFIGURATION
# =====================================================

# Web server
NEXUS_AI_HOST=0.0.0.0
NEXUS_AI_PORT=8000
NEXUS_AI_ENV=development

# Model / runtime
NEXUS_AI_MODEL=openrouter:openai/gpt-4o-mini
NEXUS_AI_RUNTIME_DIR=.runtime
NEXUS_AI_SQLITE_PATH=.runtime/nexus_ai.sqlite3
NEXUS_AI_DATABASE_URL=
NEXUS_AI_MAX_TOOL_CALLS=40
NEXUS_AI_MAX_RUN_SECONDS=180
NEXUS_AI_MAX_COST_USD=2.00
NEXUS_AI_CONTEXT_MAX_TOKENS=180000
NEXUS_AI_ENABLE_ECOSYSTEM_CAPABILITIES=true
NEXUS_AI_ENABLE_CODE_MODE=true
NEXUS_AI_AUDIT_TOOL_CALLS=true
NEXUS_AI_AGENT_NAME=nexus-ai

# Request-scoped defaults for local/manual runs.
NEXUS_MCP_URL=http://127.0.0.1:3333/mcp
NEXUS_API_TOKEN=
NEXUS_WORKSPACE_ID=
NEXUS_REQUEST_ID=

# Backend bridge
NEXUS_BACKEND_BASE_URL=http://127.0.0.1:3002/api/v1
NEXUS_INTERNAL_API_KEY=change-me
NEXUS_API_KEY=change-me

# Observability
NEXUS_AI_ENABLE_LANGFUSE=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Provider credentials
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=

# =====================================================
# RAG
# =====================================================

NEXUS_RAG_ENABLED=true
NEXUS_RAG_EXTRACTION_PROVIDER=opendataloader_pdf
NEXUS_RAG_CHUNKING_STRATEGY=document_routed_parent_child_v1
NEXUS_AI_EMBEDDING_MODEL=openai/text-embedding-3-small
NEXUS_AI_RAG_LLM_MODEL=openrouter:openai/gpt-4o-mini
NEXUS_RAG_ENABLE_CONTEXTUAL_RETRIEVAL=true
NEXUS_RAG_QUERY_TRANSFORM=multi_query_step_back
NEXUS_RAG_MULTI_QUERY_COUNT=2
NEXUS_RAG_ENABLE_STEP_BACK=true
NEXUS_RAG_DOCUMENT_ROUTE_TOP_K=5
NEXUS_RAG_DENSE_CANDIDATES=40
NEXUS_RAG_LEXICAL_CANDIDATES=40
NEXUS_RAG_RRF_K=60
NEXUS_RAG_MMR_LAMBDA=0.7
NEXUS_RAG_SUMMARY_MAX_TOKENS=300
NEXUS_RAG_CONTEXT_MAX_TOKENS=160
NEXUS_RAG_LLM_CONCURRENCY=4
NEXUS_RAG_LLM_TIMEOUT_SECONDS=60
NEXUS_RAG_PARENT_CHUNK_TOKENS=1200
NEXUS_RAG_CHILD_CHUNK_TOKENS=350
NEXUS_RAG_CHILD_OVERLAP_TOKENS=60

# Vector store
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_DOCUMENT_COLLECTION=nexus_rag_documents
QDRANT_CHUNK_COLLECTION=nexus_rag_chunks

# OpenDataLoader PDF extraction
NEXUS_RAG_OPENDATALOADER_HYBRID=off
NEXUS_RAG_OPENDATALOADER_USE_STRUCT_TREE=true
NEXUS_RAG_OPENDATALOADER_TABLE_METHOD=pdfplumber
NEXUS_RAG_OPENDATALOADER_READING_ORDER=basic
NEXUS_RAG_OPENDATALOADER_MARKDOWN_WITH_HTML=false
NEXUS_RAG_OPENDATALOADER_INCLUDE_HEADER_FOOTER=false
NEXUS_RAG_OPENDATALOADER_DETECT_STRIKETHROUGH=false
NEXUS_RAG_OPENDATALOADER_HYBRID_MODE=auto
NEXUS_RAG_OPENDATALOADER_HYBRID_TIMEOUT=120
NEXUS_RAG_OPENDATALOADER_HYBRID_FALLBACK=true
NEXUS_RAG_OPENDATALOADER_THREADS=1
NEXUS_RAG_OPENDATALOADER_HYBRID_HANCOM_AI_REGIONLIST_STRATEGY=
NEXUS_RAG_OPENDATALOADER_HYBRID_HANCOM_AI_OCR_STRATEGY=
NEXUS_RAG_OPENDATALOADER_HYBRID_HANCOM_AI_IMAGE_CACHE=
NEXUS_RAG_OPENDATALOADER_HYBRID_URL=
