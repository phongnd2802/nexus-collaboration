# =====================================================
# NEXUS AI CONFIGURATION
# =====================================================
# Copy this file to .env and fill in the values for your environment.
# The defaults below are safe for local development.
# =====================================================

# Core runtime
NEXUS_AI_MODEL=openrouter:openai/gpt-4o-mini
NEXUS_AI_ENV=development
NEXUS_MCP_URL=http://127.0.0.1:3333/mcp
NEXUS_API_TOKEN=
NEXUS_WORKSPACE_ID=
NEXUS_USER_ID=
NEXUS_REQUEST_ID=

# Runtime storage
NEXUS_AI_RUNTIME_DIR=.runtime
NEXUS_AI_SQLITE_PATH=.runtime/nexus_ai.sqlite3

# Agent behavior
NEXUS_AI_ENABLE_LANGFUSE=true
NEXUS_AI_MAX_TOOL_CALLS=40
NEXUS_AI_MAX_RUN_SECONDS=180
NEXUS_AI_MAX_COST_USD=2.00
NEXUS_AI_ENABLE_ECOSYSTEM_CAPABILITIES=true
NEXUS_AI_CONTEXT_MAX_TOKENS=180000
NEXUS_AI_ORCHESTRATION_MODE=hybrid
NEXUS_AI_PLANNER_MODEL=
NEXUS_AI_RETRIEVER_MODEL=
NEXUS_AI_SYNTHESIZER_MODEL=
NEXUS_AI_CRITIC_MODEL=
NEXUS_AI_ORCHESTRATOR_MAX_REVISIONS=1
NEXUS_AI_ORCHESTRATOR_MAX_RETRIEVAL_RETRIES=1
NEXUS_AI_ROUTER_MODEL=
NEXUS_AI_ROUTER_CONFIDENCE_THRESHOLD=0.8
NEXUS_AI_ROUTER_ENABLE_MODEL_FALLBACK=false
NEXUS_AI_RETRIEVAL_TOP_K=8
NEXUS_AI_RAG_MIN_SCORE=0.5

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# OpenRouter / OpenAI-compatible provider
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional direct OpenAI credentials
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional alternative providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Nexus backend / MCP bridge
NEXUS_BACKEND_URL=http://127.0.0.1:3000/api/v1
NEXUS_API_BASE_URL=http://127.0.0.1:3000/api/v1
NEXUS_INTERNAL_API_KEY=change-me
NEXUS_API_KEY=change-me

# RAG enablement
NEXUS_RAG_ENABLED=true
NEXUS_RAG_EXTRACTION_PROVIDER=opendataloader_pdf
NEXUS_RAG_CHUNKING_STRATEGY=document_routed_parent_child_v1
NEXUS_RAG_EMBEDDING_PROVIDER=openrouter
NEXUS_RAG_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
NEXUS_RAG_LLM_MODEL=openrouter:openai/gpt-4o-mini
NEXUS_RAG_SUMMARY_MAX_TOKENS=220
NEXUS_RAG_CONTEXT_MAX_TOKENS=140
NEXUS_RAG_LLM_TIMEOUT_SECONDS=60
NEXUS_RAG_LLM_CONCURRENCY=4
NEXUS_RAG_ENABLE_CONTEXTUAL_RETRIEVAL=true
NEXUS_RAG_QUERY_TRANSFORM=multi_query_step_back
NEXUS_RAG_MULTI_QUERY_COUNT=3
NEXUS_RAG_ENABLE_STEP_BACK=true
NEXUS_RAG_ENABLE_HYDE=false
NEXUS_RAG_DOCUMENT_ROUTE_TOP_K=3
NEXUS_RAG_DENSE_CANDIDATES=40
NEXUS_RAG_LEXICAL_CANDIDATES=40
NEXUS_RAG_MMR_LAMBDA=0.65
NEXUS_RAG_RRF_K=60
NEXUS_RAG_MAX_PLAN_SEARCHES=4

# RAG / opendataloader
NEXUS_RAG_OPENDATALOADER_USE_STRUCT_TREE=false
NEXUS_RAG_OPENDATALOADER_TABLE_METHOD=default
NEXUS_RAG_OPENDATALOADER_READING_ORDER=xycut
NEXUS_RAG_OPENDATALOADER_MARKDOWN_WITH_HTML=false
NEXUS_RAG_OPENDATALOADER_INCLUDE_HEADER_FOOTER=false
NEXUS_RAG_OPENDATALOADER_DETECT_STRIKETHROUGH=false
NEXUS_RAG_OPENDATALOADER_HYBRID=off
NEXUS_RAG_OPENDATALOADER_HYBRID_MODE=auto
NEXUS_RAG_OPENDATALOADER_HYBRID_URL=
NEXUS_RAG_OPENDATALOADER_HYBRID_TIMEOUT=0
NEXUS_RAG_OPENDATALOADER_HYBRID_FALLBACK=false
NEXUS_RAG_OPENDATALOADER_HANCOM_REGIONLIST_STRATEGY=table-first
NEXUS_RAG_OPENDATALOADER_HANCOM_OCR_STRATEGY=auto
NEXUS_RAG_OPENDATALOADER_HANCOM_IMAGE_CACHE=memory
NEXUS_RAG_OPENDATALOADER_THREADS=1

# Vector database
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_DOCUMENT_COLLECTION=nexus_rag_documents
QDRANT_CHUNK_COLLECTION=nexus_rag_chunks
NEXUS_RAG_PARENT_CHUNK_TOKENS=1200
NEXUS_RAG_CHILD_CHUNK_TOKENS=280
NEXUS_RAG_CHILD_OVERLAP_TOKENS=60

