{
  "name": "nexus-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for the Nexus Collaboration backend API",
  "type": "module",
  "bin": {
    "nexus-mcp": "dist/index.js",
    "nexus-mcp-http": "dist/http.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "inspect:http": "npx @modelcontextprotocol/inspector"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "dotenv": "^17.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC"
}
