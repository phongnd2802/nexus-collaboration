# Nexus backend base URL.
NEXUS_API_BASE_URL=http://localhost:3002/api/v1

# Internal service-to-service key used by MCP -> Nexus backend requests.
NEXUS_API_KEY=change-me

# Required only for stdio mode, where the MCP server cannot read a user Authorization header.
NEXUS_API_TOKEN=

# Optional backend context headers forwarded by the MCP server.
NEXUS_PROJECT_ID=
NEXUS_APP_ID=
NEXUS_ORGANIZATION_ID=

# Request timeout in milliseconds.
NEXUS_API_TIMEOUT_MS=30000

# Streamable HTTP server settings.
NEXUS_MCP_HTTP_HOST=127.0.0.1
NEXUS_MCP_HTTP_PORT=3333
NEXUS_MCP_HTTP_PATH=/mcp
NEXUS_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
