# =====================================================
# NEXUS - DOCKER COMPOSE DEFAULTS
# =====================================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexus_dev
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Qdrant Vector Database
QDRANT_PORT=6333

# Backend
BACKEND_PORT=3002
JWT_SECRET=nexus_dev_jwt_secret_change_in_production_min32chars
NEXUS_AI_BASE_URL=http://nexus-ai:8000
NEXUS_AI_API_KEY=change-me
NEXUS_AI_TIMEOUT_MS=60000
AGENT_CHAT_DEBUG_LOG=false

# Frontend
FRONTEND_PORT=5175

# Nexus AI
NEXUS_AI_PORT=8000
NEXUS_AI_MODEL=openai/gpt-4o-mini
NEXUS_AI_DEBUG_LOG=false
NEXUS_AI_RAW_PROVIDER_CAPTURE=false
NEXUS_AI_RAW_RESPONSE_DIR=raw-provider-responses
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_APP_URL=http://localhost:5175
OPENROUTER_APP_TITLE=Nexus

# Optional: Add your API keys here for full functionality
# OPENAI_API_KEY=sk-your-key-here
# LIVEKIT_API_KEY=your-key-here
