# =====================================================
# NEXUS BACKEND CONFIGURATION
# =====================================================
# Copy this file to .env and update with your values.
# =====================================================

# Application
PORT=3002
NODE_ENV=development
API_PREFIX=api
FRONTEND_URL=http://localhost:5175
APP_URL=http://localhost:5175
API_URL=http://localhost:3002
API_BASE_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:5175,http://localhost:5173,http://localhost:3000
MAX_FILE_SIZE_BYTES=10485760

# =====================================================
# JWT / AUTH
# =====================================================

JWT_SECRET=your_jwt_secret_min32chars_change_me
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_DAYS=30

# Comma-separated list of enabled auth providers.
# Valid values: local | google | github | gitlab | magic-link | keycloak | clerk | auth0
AUTH_PROVIDERS=local,google,github,magic-link

# Magic link / email auth
MAGIC_LINK_TTL_SECONDS=900
EMAIL_PROVIDER=none
EMAIL_FROM="Nexus <noreply@example.com>"
EMAIL_REPLY_TO=

# SMTP (used by magic-link and SMTP email provider)
SMTP_HOST=
SMTP_HOST_IP=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_CONNECTION_TIMEOUT_MS=20000
SMTP_GREETING_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_DNS_TIMEOUT_MS=8000
SMTP_TLS_SERVERNAME=

# =====================================================
# DATABASE / CACHE
# =====================================================

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nexus_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=your_db_password
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =====================================================
# STORAGE
# =====================================================

STORAGE_PROVIDER=local-fs

LOCAL_FS_PATH=./data/uploads
LOCAL_FS_PUBLIC_URL=/uploads
LOCAL_FS_SIGNING_KEY=change_me_to_a_long_random_string

STORAGE_BUCKET=nexus-dev
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=
STORAGE_FORCE_PATH_STYLE=false

GCS_PROJECT_ID=
GCS_KEY_FILE=
AZURE_STORAGE_CONNECTION_STRING=

# Legacy R2_* env vars are still honored for backwards compatibility.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nexus-dev
R2_PUBLIC_URL=

# =====================================================
# AI PROVIDER
# =====================================================

AI_PROVIDER=openai

# OpenAI / OpenRouter-compatible provider
AI_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:5175
OPENROUTER_APP_TITLE=Nexus

# Optional alternative providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# =====================================================
# NEXUS AI SERVICE BRIDGE
# =====================================================

NEXUS_AI_BASE_URL=http://localhost:8000
NEXUS_AI_TIMEOUT_MS=60000
NEXUS_INTERNAL_API_KEY=change-me
NEXUS_API_KEY=change-me

# =====================================================
# RAG / VECTOR / SEARCH
# =====================================================

NEXUS_RAG_ENABLED=true
NEXUS_RAG_EXTRACTION_PROVIDER=opendataloader_pdf
NEXUS_RAG_CHUNKING_STRATEGY=document_routed_parent_child_v1
NEXUS_RAG_EMBEDDING_PROVIDER=openrouter
NEXUS_RAG_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
NEXUS_RAG_LLM_MODEL=openrouter:openai/gpt-4o-mini
NEXUS_RAG_SUMMARY_MAX_TOKENS=220
NEXUS_RAG_CONTEXT_MAX_TOKENS=140
NEXUS_RAG_LLM_TIMEOUT_SECONDS=60
NEXUS_RAG_LLM_CONCURRENCY=4
NEXUS_RAG_ENABLE_CONTEXTUAL_RETRIEVAL=true
NEXUS_RAG_QUERY_TRANSFORM=multi_query_step_back
NEXUS_RAG_MULTI_QUERY_COUNT=3
NEXUS_RAG_ENABLE_STEP_BACK=true
NEXUS_RAG_ENABLE_HYDE=false
NEXUS_RAG_DOCUMENT_ROUTE_TOP_K=3
NEXUS_RAG_DENSE_CANDIDATES=40
NEXUS_RAG_LEXICAL_CANDIDATES=40
NEXUS_RAG_MMR_LAMBDA=0.65
NEXUS_RAG_RRF_K=60
NEXUS_RAG_MAX_PLAN_SEARCHES=4

# RAG / opendataloader
NEXUS_RAG_OPENDATALOADER_USE_STRUCT_TREE=false
NEXUS_RAG_OPENDATALOADER_TABLE_METHOD=default
NEXUS_RAG_OPENDATALOADER_READING_ORDER=xycut
NEXUS_RAG_OPENDATALOADER_MARKDOWN_WITH_HTML=false
NEXUS_RAG_OPENDATALOADER_INCLUDE_HEADER_FOOTER=false
NEXUS_RAG_OPENDATALOADER_DETECT_STRIKETHROUGH=false
NEXUS_RAG_OPENDATALOADER_HYBRID=off
NEXUS_RAG_OPENDATALOADER_HYBRID_MODE=auto
NEXUS_RAG_OPENDATALOADER_HYBRID_URL=
NEXUS_RAG_OPENDATALOADER_HYBRID_TIMEOUT=0
NEXUS_RAG_OPENDATALOADER_HYBRID_FALLBACK=false
NEXUS_RAG_OPENDATALOADER_HANCOM_REGIONLIST_STRATEGY=table-first
NEXUS_RAG_OPENDATALOADER_HANCOM_OCR_STRATEGY=auto
NEXUS_RAG_OPENDATALOADER_HANCOM_IMAGE_CACHE=memory
NEXUS_RAG_OPENDATALOADER_THREADS=1

# Vector database
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_DOCUMENT_COLLECTION=nexus_rag_documents
QDRANT_CHUNK_COLLECTION=nexus_rag_chunks
NEXUS_RAG_PARENT_CHUNK_TOKENS=1200
NEXUS_RAG_CHILD_CHUNK_TOKENS=280
NEXUS_RAG_CHILD_OVERLAP_TOKENS=60

SEARCH_PROVIDER=pg-trgm
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=

# =====================================================
# VIDEO / MEETINGS
# =====================================================

LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_SECRET=

# =====================================================
# OAUTH / SSO
# =====================================================

GOOGLE_AUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=your_google_client_secret
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3002/api/v1/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3002/api/v1/integrations/google/callback

GITHUB_AUTH_CLIENT_ID=your_github_client_id
GITHUB_AUTH_CLIENT_SECRET=your_github_client_secret
GITHUB_AUTH_REDIRECT_URI=http://localhost:3002/api/v1/oauth/github/callback

GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_GITHUB_APP_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_SLUG=your-github-app-slug

# =====================================================
# PUSH NOTIFICATIONS
# =====================================================

PUSH_PROVIDER=none

FCM_PROJECT_ID=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
EXPO_ACCESS_TOKEN=

FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_WEB_CONFIG=

# =====================================================
# EMAIL PROVIDERS
# =====================================================

AGENTIC_RAG_BASE_URL=http://localhost:8000
AGENTIC_RAG_TIMEOUT_MS=120000
AGENTIC_RAG_STREAM_TIMEOUT_MS=300000

# =====================================================
# EMAIL PROVIDER (SMTP only)
# =====================================================
# SMTP is the only supported email provider. Set EMAIL_PROVIDER=smtp
# (or leave unset — smtp is the default).

EMAIL_PROVIDER=smtp
EMAIL_FROM="Nexus <noreply@example.com>"
EMAIL_REPLY_TO=

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM — legacy alias for EMAIL_FROM, still honored

# =====================================================
# INTEGRATIONS
# =====================================================

GIPHY_API_KEY=
MCP_SERVERS_JSON=
